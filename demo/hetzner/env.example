# Copy to .env in this directory on the server and fill in. Never commit .env.

# The name Caddy serves and gets a certificate for. Its DNS A record must
# point at this server before `docker compose up`, or issuance fails.
WHITE_CUBE_HOSTNAME=white-cube-demo.polycultureresearch.com

# Gates /mcp and /metrics/{name}/query and redacts sql/bind from /dag. Reuse
# the token clients already hold for the Fly instance if you still have it;
# a new one breaks their `claude mcp add` configs.
BREAKDOWN_API_TOKEN=
